{
  "manifest_version": 3,
  "name": "TUS CLASS シラバス比較・時間割",
  "short_name": "TUS CLASS Helper",
  "version": "0.9.6",
  "description": "成績評価公開授業照会 / シラバス照会画面に「追加」「リンク」ボタンを追加し、拡張機能独自のページでシラバス比較・簡易時間割表・成績分布の紐付けを行えます。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://class.admin.tus.ac.jp/*",
    "https://*.tus.ac.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TUS CLASS Helper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://class.admin.tus.ac.jp/*",
        "https://*.tus.ac.jp/*"
      ],
      "js": ["content/parser.js", "content/content.js", "content/sidebar.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard/dashboard.html", "dashboard/dashboard.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
